# Dali AI local environment template
# Copy this file to .env for local development.
# NEVER commit .env or real secrets to GitHub.

# Optional: public URL of your Dali AI deployment.
APP_ORIGIN=https://your-dali-domain.example

# Gemini/g4f settings
G4F_MODEL=gemini-3.5-flash

# Preferred: Hugging Face ZeroGPU XTTS Space.
# After creating your Space, use its Space ID, for example:
# XTTS_HF_SPACE=your-hf-username/dali-ai-xtts
XTTS_HF_SPACE=

# Optional Hugging Face token for a private Space.
XTTS_HF_TOKEN=

# Voice reference used for cloning.
# Temporary default points to the current public repo file.
# Move this audio to private storage before production use.
XTTS_REFERENCE_URL=https://raw.githubusercontent.com/daliai20072026-ui/daliai/main/kikivoice-cloned-file-2026-10-05-05-56-45-9835.mp3

# Gradio API endpoint exposed by huggingface-space/app.py
XTTS_HF_API_NAME=/synthesize

# Fallback: dedicated XTTS server.
XTTS_SERVER_URL=
XTTS_SERVER_TOKEN=

# XTTS language code. Arabic is the default.
DALI_TTS_LANGUAGE=ar

# Maximum time allowed for one XTTS request.
XTTS_TIMEOUT_SECONDS=120

# Optional Redis URL for rate limiting.
REDIS_URL=

# Private Instagram Agent (Meta Graph API)
# Configure these as Vercel Environment Variables; never commit real secrets.
INSTAGRAM_GRAPH_VERSION=v26.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Generate a long random value for the private owner-only connect page.
INSTAGRAM_OWNER_KEY=
INSTAGRAM_REDIRECT_URI=https://your-dali-domain.example/api/instagram/callback
# Optional fallback token configuration; prefer OAuth + Redis.
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_ALLOWED_IG_USER_ID=
# Public HTTPS image URL for scheduled posts (single-image fallback).
INSTAGRAM_DEFAULT_IMAGE_URL=
# Optional comma-separated public HTTPS image URLs; scheduler rotates daily.
INSTAGRAM_DAILY_IMAGE_URLS=
# Leave false until Meta OAuth, Redis, and public images are verified.
INSTAGRAM_AUTO_POST_ENABLED=false
# Set a strong secret; Vercel Cron uses it to authenticate scheduled requests.
CRON_SECRET=
# REDIS_URL above is required for secure persistent token storage and duplicate prevention.

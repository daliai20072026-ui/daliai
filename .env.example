# Dali AI local environment template
# Copy this file to .env for local development.
# NEVER commit .env or real secrets to GitHub.

# Optional: public URL of your Dali AI deployment.
APP_ORIGIN=https://your-dali-domain.example

# Gemini/g4f settings
G4F_MODEL=gemini-3.5-flash

# Remote XTTS voice server
# This must point to the real XTTS Flask endpoint.
# Example: http://YOUR_SERVER_IP:8000/tts
XTTS_SERVER_URL=http://YOUR_XTTS_SERVER:8000/tts

# Optional shared secret between Dali AI and the XTTS server.
# Leave empty if XTTS_SERVER_TOKEN is not enabled on the XTTS server.
XTTS_SERVER_TOKEN=

# XTTS language code. Arabic is the default.
DALI_TTS_LANGUAGE=ar

# Maximum time allowed for one XTTS request.
XTTS_TIMEOUT_SECONDS=120

# Optional Redis URL for rate limiting.
REDIS_URL=
